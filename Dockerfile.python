# Dockerfile.python
# Multi-stage build for Python FastAPI services (children_*.py)
FROM python:3.11-slim AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt pyproject.toml ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Production stage
FROM python:3.11-slim AS runner

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -g 1001 -r appgroup && \
    useradd -u 1001 -r -g appgroup -s /sbin/nologin -d /app appuser

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY --chown=appuser:appgroup *.py ./
COPY --chown=appuser:appgroup project_source ./project_source

# Create required directories
RUN mkdir -p /app/data /app/logs /app/models && \
    chown -R appuser:appgroup /app/data /app/logs /app/models

# Switch to non-root
USER appuser

# Expose port
EXPOSE 8888

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:8888/health/live || exit 1

# Run
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
CMD ["python", "children_robot_system.py"]