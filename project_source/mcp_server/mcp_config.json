    "allowed_origins": ["*"],
    "rate_limit": {
      "enabled": true,
      "requests_per_minute": 100
    },
    "auth_required": false
  },
  "logging": {
    "enabled": true,
    "file_path": "./logs/mcp_server.log",
    "max_file_size_mb": 10,
    "backup_count": 5
  },
