# ─── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ─── Authentication ────────────────────────────────────
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRES_IN=24h

# ─── Database ──────────────────────────────────────────
# DATABASE_URL=postgresql://robot:robot123@localhost:5432/robot_db

# ─── Encryption ────────────────────────────────────────
ENCRYPTION_KEY=change-this-to-a-32-char-minimum-secret-key

# ─── AI / LLM ──────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_ENDPOINT=https://api.openai.com/v1

# ─── Payments (Stripe) ────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...

# ─── Email ─────────────────────────────────────────────
# SENDGRID_API_KEY=SG....
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your-smtp-password
# FROM_EMAIL=hello@robobuddy.eu

# ─── Security ──────────────────────────────────────────
# CORS_ORIGINS=https://robobuddy.eu,https://admin.robobuddy.eu
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100

# ─── App ───────────────────────────────────────────────
# APP_URL=https://robobuddy.eu
