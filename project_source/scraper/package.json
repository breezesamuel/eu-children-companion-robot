{
  "name": "robomate-scraper",
  "version": "2.0.0",
  "description": "Web scraping, AI content generation, and multi-platform auto-publishing module for RoboMate content ingestion system",
  "main": "index.js",
  "keywords": [
    "scraper",
    "web-scraping",
    "e-commerce",
    "ai-writing",
    "auto-publish",
    "proxy-manager",
    "content-generation",
    "seo",
    "social-media-publishing",
    "pexels-api",
    "children-robot",
    "robomate"
  ],
  "scripts": {
    "start": "node index.js",
    "publish": "node index.js --publish",
    "scrape": "node index.js --scrape",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --passWithNoTests",
    "lint": "eslint . --ext .js",
    "format": "prettier --write \"**/*.js\""
  },
  "dependencies": {
    "axios": "^1.16.0",
    "playwright": "^1.60.0",
    "cron": "^3.1.0",
    "sharp": "^0.33.0",
    "form-data": "^4.0.0",
    "cheerio": "^1.0.0",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "jest": "^29.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/robomate/scraper"
  }
}
