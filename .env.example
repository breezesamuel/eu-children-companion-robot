# European Children Companion Robot - Production Environment Template
# Copy this file to .env and fill in ALL values before deployment
# NEVER commit .env to version control!

# =============================================================================
# CORE INFRASTRUCTURE (Generate fresh for production)
# =============================================================================
POSTGRES_PASSWORD=                    # 32+ chars, e.g. openssl rand -base64 32
JWT_SECRET=                           # 64+ chars, e.g. openssl rand -base64 48
JWT_REFRESH_SECRET=                   # 64+ chars, different from JWT_SECRET
REDIS_PASSWORD=                       # Optional but recommended, 32+ chars
PERSISTENCE_ENCRYPTION_KEY=           # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_LOOP_SALT=                       # 32+ chars for pseudonymization
AUTONOMOUS_INTERNAL_KEY=              # 256-bit hex: openssl rand -hex 32

# =============================================================================
# PAYMENTS (Stripe LIVE mode - get from https://dashboard.stripe.com)
# =============================================================================
STRIPE_SECRET_KEY=                    # sk_live_...
STRIPE_PUBLISHABLE_KEY=               # pk_live_...
STRIPE_WEBHOOK_SECRET=                # whsec_... (configure webhook to https://api.children-robot.com/api/payments/webhook)

# =============================================================================
# EMAIL (SendGrid - get from https://app.sendgrid.com)
# =============================================================================
SENDGRID_API_KEY=                     # SG.xxx
SENDGRID_FROM_EMAIL=                  # noreply@children-robot.com (must be verified sender)

# =============================================================================
# EXTERNAL AUTH
# =============================================================================
GOOGLE_CLIENT_ID=                     # From Google Cloud Console OAuth 2.0
GOOGLE_CLIENT_SECRET=                 # From Google Cloud Console OAuth 2.0
FACEBOOK_APP_TOKEN=                   # From Meta Developer Portal

# =============================================================================
# DOMAIN & TLS (Configure DNS first!)
# =============================================================================
DOMAIN=children-robot.com
CORS_ORIGINS=https://app.children-robot.com,https://parent.children-robot.com
ACME_EMAIL=admin@children-robot.com   # Let's Encrypt registration email

# =============================================================================
# MONITORING
# =============================================================================
GRAFANA_ADMIN=admin
GRAFANA_PASSWORD=                     # Secure password for Grafana admin

# =============================================================================
# EVIDENCE CHANNELS (For autonomous ops evidence collection)
# =============================================================================
GITHUB_TOKEN=                         # GitHub PAT with 'repo' scope
GITHUB_REPO=org/robot-evidence        # Evidence repository
WECOM_WEBHOOK_URL=                    # Enterprise WeChat webhook
WECOM_WEBHOOK_SECRET=                 # WeCom webhook secret
DINGTALK_WEBHOOK_URL=                 # DingTalk webhook
DINGTALK_WEBHOOK_SECRET=              # DingTalk webhook secret

# =============================================================================
# LOGISTICS (Shippo LIVE - get from https://goshippo.com)
# =============================================================================
SHIPPO_API_KEY=                       # Live API key
SHIPPO_WEBHOOK_SECRET=                # Configure webhook to https://api.children-robot.com/api/logistics/webhook

# =============================================================================
# CLASSROOM / LTI (Google Classroom API)
# =============================================================================
CLASSROOM_CLIENT_ID=                  # Google Cloud OAuth Client ID
CLASSROOM_CLIENT_SECRET=              # Google Cloud OAuth Client Secret
CLASSROOM_REDIRECT_URI=https://api.children-robot.com/api/classroom/callback
CLASSROOM_PROJECT_ID=                 # Google Cloud Project ID
CLASSROOM_WEBHOOK_URL=https://api.children-robot.com/api/classroom/webhook

# =============================================================================
# FEATURE FLAGS (Pre-configured for production)
# =============================================================================
ENABLE_HIDDEN_API=true
AUTONOMOUS_AUTOSTART=1
AUTONOMOUS_INTERVAL=300
HUNTER_ONLINE=1
AUTONOMOUS_STATE_BACKEND=redis
DEPLOYMENT_REGION=EU                  # Enables EU AI Act compliance gates

# =============================================================================
# OPTIONAL (Observability)
# =============================================================================
# SENTRY_DSN=                         # Sentry DSN for error tracking
# OTEL_EXPORTER_OTLP_ENDPOINT=        # e.g. jaeger:4317
# LOG_LEVEL=INFO